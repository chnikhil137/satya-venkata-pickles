{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": { "@/*": ["./*"] }
  },
  "include": [
    "src",
    "components/ui/sheet.tsx",
    "components/ui/empty.tsx",
    "components/ui/sonner.tsx",
    "lib/utils.ts"
  ]
}
